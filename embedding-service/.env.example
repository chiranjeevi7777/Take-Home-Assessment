# Embedding Service Environment Configuration
# Copy to .env and adjust values

EMB_EMBEDDING_PROVIDER=sentence_transformer
EMB_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMB_EMBEDDING_DIMENSION=384
EMB_CHROMA_PERSIST_DIR=./chroma_data
EMB_CHROMA_COLLECTION_NAME=posts
EMB_HOST=0.0.0.0
EMB_PORT=8001
EMB_DEBUG=true

# Uncomment to use OpenAI instead:
# EMB_EMBEDDING_PROVIDER=openai
# EMB_OPENAI_API_KEY=sk-your-key-here
# EMB_OPENAI_MODEL=text-embedding-3-small
# EMB_EMBEDDING_DIMENSION=1536
